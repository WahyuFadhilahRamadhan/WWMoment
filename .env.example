# Supabase project credentials
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Passcode used to unlock the "Admin" panel on /gallery (photo download +
# CSV metadata export). This is a lightweight client-side gate, not a full
# auth system - keep it simple and change it before/after the event.
NEXT_PUBLIC_ADMIN_PASSCODE=change-me
