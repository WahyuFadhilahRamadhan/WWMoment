# Supabase project credentials
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase "service_role" secret key (Settings -> API -> Project API keys).
# Server-only - NEVER prefix this with NEXT_PUBLIC_. Used exclusively by the
# /api/admin/* server routes to delete photos (bypassing RLS). Keep this
# secret; anyone with it has full read/write access to your database.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Passcode required to enable Admin mode at /admin (download, delete photos,
# and export CSV metadata on /gallery). Server-only - never exposed to the
# browser. Change it before/after the event.
ADMIN_PASSCODE=change-me

# Optional: restrict the upload page (/) to guests physically near the
# venue, checked via the browser's GPS. Leave NEXT_PUBLIC_VENUE_LAT and
# NEXT_PUBLIC_VENUE_LNG empty to disable this check entirely.
# Get coordinates: open Google Maps, long-press the venue location, and
# copy the two numbers that appear (e.g. "-6.200000, 106.816666").
NEXT_PUBLIC_VENUE_LAT=
NEXT_PUBLIC_VENUE_LNG=
# Allowed radius around the venue, in meters. Defaults to 500 if unset.
NEXT_PUBLIC_VENUE_RADIUS_METERS=500
